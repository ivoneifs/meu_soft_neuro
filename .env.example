# Copie para .env e preencha antes de subir o docker-compose.

# Obrigatório: string de conexão do MongoDB
MONGO_URL=mongodb+srv://usuario:senha@cluster/neuro

# Necessário para os recursos de IA (geração de laudo etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin master. Se ADMIN_PASSWORD estiver definida, o servidor reaplica essa
# senha a cada boot e garante a conta ativa.
ADMIN_EMAIL=ivonei.admin@neuro.com
ADMIN_PASSWORD=

# Porta pública do frontend (nginx)
WEB_PORT=8080
